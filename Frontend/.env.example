# Copy this file to .env and fill in real values for local dev.
# For production, set these as environment variables in your hosting
# provider (Vercel/Netlify/etc.) — never commit a real .env file.

# URL of your deployed backend API
VITE_API_URL=http://localhost:3000

# Google OAuth Client ID — must match GOOGLE_CLIENT_ID on the backend
# Create one at https://console.cloud.google.com/apis/credentials
# (Authorized JavaScript origins: your frontend URL, e.g. http://localhost:5173)
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
